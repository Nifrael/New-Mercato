<% content_for(:title, "Tableau de bord — New Mercato") %>

<div class="container page">
  <header class="page-header">
    <div class="page-header__text">
      <p class="page-header__eyebrow"><%= @club.name %> · <%= @club.league %></p>
      <h1>Bonjour <%= current_user.first_name %></h1>
      <p class="page-header__lead">
        <%= l(Date.current, format: "%A %-d %B").capitalize %>
        <% if pending_requests_count.positive? %>
          — <strong class="page-header__highlight"><%= pluralize(pending_requests_count, "demande attend", plural: "demandes attendent") %></strong> votre réponse.
        <% end %>
      </p>
    </div>
    <%= link_to players_path, class: "btn btn--primary" do %>
      <%= icon(:search, size: 18) %> Trouver un joueur
    <% end %>
  </header>

  <section class="grid-auto dashboard__stats" aria-label="Chiffres clés">
    <div class="card">
      <%= render "shared/stat", label: "Budget", value: compact_currency(@club.budget) %>
    </div>
    <%= link_to dashboard_players_path, class: "card card--interactive" do %>
      <%= render "shared/stat", label: "Effectif actuel", value: @squad_count %>
    <% end %>
    <%= link_to loaned_in_dashboard_players_path, class: "card card--interactive" do %>
      <%= render "shared/stat", label: "Empruntés", value: @loaned_in_count %>
    <% end %>
    <%= link_to loaned_out_dashboard_players_path, class: "card card--interactive" do %>
      <%= render "shared/stat", label: "Prêtés", value: @loaned_out_count %>
    <% end %>
    <%= link_to dashboard_bookings_path, class: "card card--interactive" do %>
      <%= render "shared/stat", label: "À traiter", value: pending_requests_count, accent: pending_requests_count.positive? %>
    <% end %>
  </section>

  <section class="stack" aria-labelledby="a-traiter">
    <h2 id="a-traiter" class="section-title">À traiter</h2>
    <% if @requests_to_handle.any? %>
      <div class="grid-auto dashboard__requests">
        <%= render partial: "bookings/request_card", collection: @requests_to_handle, as: :booking %>
      </div>
    <% else %>
      <div class="empty-state">
        <p class="empty-state__title">Rien à traiter pour l'instant</p>
        <p>Les demandes de location de vos joueurs apparaîtront ici.</p>
      </div>
    <% end %>
  </section>

  <section class="stack" aria-labelledby="prets-en-cours">
    <h2 id="prets-en-cours" class="section-title">Prêts en cours</h2>
    <% if @active_loans.any? %>
      <div class="grid-auto dashboard__loans">
        <%= render partial: "dashboards/loan_card", collection: @active_loans, as: :loan, locals: { club: @club } %>
      </div>
    <% else %>
      <div class="empty-state">
        <p class="empty-state__title">Aucun prêt en cours</p>
        <p>Trouvez un joueur pour renforcer votre effectif.</p>
      </div>
    <% end %>
  </section>
</div>
