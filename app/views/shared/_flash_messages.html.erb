<%# locals: () -%>
<%# Messages flash affichés en toasts (contrôleur Stimulus « toast » : fermeture auto + au clic).
    data-turbo-temporary : Turbo retire les toasts avant de mettre la page en cache,
    pour qu'un ancien message ne réapparaisse pas en revenant en arrière. %>
<% if flash.any? %>
  <div class="toasts" data-turbo-temporary>
    <% flash.each do |type, message| %>
      <div class="<%= class_names("toast", "toast--#{flash_variant(type)}": flash_variant(type)) %>"
           role="<%= flash_role(type) %>"
           data-controller="toast">
        <%= icon(flash_variant(type) == :danger ? :alert : :check, size: 20) %>
        <p class="toast__message"><%= message %></p>
        <button type="button" class="toast__close" aria-label="Fermer" data-action="toast#dismiss">
          <%= icon(:close, size: 18) %>
        </button>
      </div>
    <% end %>
  </div>
<% end %>
