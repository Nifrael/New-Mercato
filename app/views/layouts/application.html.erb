<!DOCTYPE html>
<html lang="fr">
  <head>
    <title><%= content_for(:title) || "New Mercato" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%# Polices : preconnect pour ouvrir la connexion au plus tôt, puis une seule feuille Google Fonts. %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&family=Mina:wght@700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/vanilla-calendar-pro/styles/index.css" rel="stylesheet">
    <script src="https://kit.fontawesome.com/5ae925a9ee.js" crossorigin="anonymous"></script>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <% unless current_page?(root_path) %>
      <%= render "layouts/navbar" %>
    <% end %>
    <main>
      <%= render "shared/flash_messages" %>
      <%= yield %>
    </main>
    <% unless current_page?(root_path) %>
      <%= render "layouts/footer" %>
    <% end %>
  </body>
</html>
