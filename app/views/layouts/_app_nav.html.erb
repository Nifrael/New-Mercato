<%# locals: () -%>
<%# Navigation de l'application (utilisateurs connectés uniquement, cf. app_shell?).
    UN seul HTML : le CSS (layout/_app-shell.scss) en fait une barre d'onglets en bas
    sur mobile, et une sidebar à partir de $lg. %>
<header class="app-nav app-nav--sidebar">
  <%= link_to dashboard_path, class: "brand app-nav__brand" do %>
    <span class="brand__logo" aria-hidden="true">NM</span>
    <span class="brand__wordmark">New Mercato</span>
  <% end %>

  <nav class="app-nav__menu" aria-label="Navigation principale">
    <%= nav_link "Tableau de bord", dashboard_path, icon: :dashboard, short_label: "Accueil", exact: true %>
    <%= nav_link "Trouver un joueur", players_path, icon: :search, short_label: "Joueurs" %>
    <%= nav_link "Demandes", dashboard_bookings_path, icon: :inbox, badge: pending_requests_count %>
    <%= nav_link "Mon effectif", dashboard_players_path, icon: :squad, short_label: "Effectif" %>
    <%= nav_link "Clubs", clubs_path, icon: :shield %>
  </nav>

  <div class="app-nav__account">
    <span class="app-nav__avatar" aria-hidden="true"><%= current_user.initials %></span>
    <span class="app-nav__identity">
      <span class="app-nav__name"><%= current_user.first_name %> <%= current_user.last_name %></span>
      <span class="app-nav__role">
        <%= t("activerecord.enums.user.role.#{current_user.role}") %> · <%= current_user.club.name %>
      </span>
    </span>
    <%= button_to destroy_user_session_path, method: :delete, class: "app-nav__logout",
                  "aria-label": "Se déconnecter" do %>
      <%= icon(:logout) %>
    <% end %>
  </div>
</header>
