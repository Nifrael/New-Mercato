<div class="container mx-auto px-4 py-8">
  <h1 class="text-4xl font-bold text-center mb-8">Nos Clubs</h1>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @clubs.each do |club| %>
      <%= link_to club_path(club), class: "block bg-white shadow-md rounded-lg overflow-hidden" do %>
        <div class="h-48 bg-gray-200 flex items-center justify-center py-4">
          <%= image_tag club.logo, alt: "Logo de #{club.name}", class: "h-full object-contain" %>
        </div>
        <div class="p-4">
          <h2 class="text-xl font-semibold mb-2"><%= club.name %></h2>
          <p class="text-gray-600">Propriétaire : <%= club.users.first.first_name %> <%= club.users.first.last_name %></p>
          <div class="mt-4">
            <%= image_tag club.users.first.photo, alt: "Photo de #{club.users.first.first_name}", class: "w-16 h-16 rounded-full object-cover" %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
