<div class="container mx-auto px-4 py-8">
  <h1 class="text-4xl font-bold text-center mb-8">Clubs Participants</h1>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12">
    <% @clubs.each do |club| %>
      <%= link_to club_path(club), class: "block green-bg shadow-md rounded-lg overflow-hidden flex flex-col" do %>
        <div class="h-48 flex items-center justify-center p-4">
          <%= image_tag club.logo, alt: "Logo de #{club.name}", class: "h-full object-contain" %>
        </div>
        <div class="p-8 flex-grow flex flex-col justify-between">
          <h2 class="club-card__name text-xl font-semibold mb-2 min-h-[3rem]"><%= club.name %></h2>
          <% if club.dirigeant %>
            <p class="club-card__owner text-gray-600 min-h-[2rem]">Propriétaire : <%= club.dirigeant.first_name %> <%= club.dirigeant.last_name %></p>
            <div class="mt-4">
              <%= image_tag club.dirigeant.photo, alt: "Photo de #{club.dirigeant.first_name}", class: "w-16 h-16 rounded-full object-cover" %>
            </div>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
