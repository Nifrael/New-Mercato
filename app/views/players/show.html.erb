<% content_for(:title, "#{@player.name} — New Mercato") %>

<div class="container page player-page">
  <%= link_to players_path, class: "player-page__back" do %>
    ← Tous les joueurs
  <% end %>

  <section class="card player-hero player-page__hero">
    <%= player_avatar(@player, size: :xl) %>
    <div class="player-hero__identity">
      <p class="page-header__eyebrow"><%= @player.club.name %> · <%= @player.club.league %></p>
      <h1 class="player-hero__name"><%= @player.name %></h1>
      <div class="cluster">
        <span class="player-card__position"><%= t("activerecord.enums.player.position.#{@player.position}") %></span>
        <%= status_badge(@player) %>
      </div>
    </div>
  </section>

  <aside class="player-page__booking" aria-label="Louer ce joueur">
    <%= render "players/booking_panel", player: @player, booking: @booking, can_book: @can_book, can_edit: @can_edit %>
  </aside>

  <section class="grid-auto player-page__stats" aria-label="Caractéristiques">
    <div class="card"><%= render "shared/stat", label: "Valeur", value: compact_currency(@player.market_value) %></div>
    <div class="card"><%= render "shared/stat", label: "Prix / jour", value: number_to_currency(@player.price_per_day, precision: 0), accent: true %></div>
    <div class="card"><%= render "shared/stat", label: "Âge", value: "#{@player.age} ans" %></div>
    <div class="card"><%= render "shared/stat", label: "Taille", value: "#{@player.height} cm" %></div>
    <div class="card"><%= render "shared/stat", label: "Pied fort", value: @player.foot %></div>
    <div class="card"><%= render "shared/stat", label: "Nationalité", value: @player.nationality %></div>
  </section>

  <section class="card availability player-page__availability" aria-labelledby="disponibilites">
    <h2 id="disponibilites" class="card__title">Disponibilités</h2>
    <% if @unavailabilities.any? %>
      <ul class="availability__list" role="list">
        <% @unavailabilities.each do |loan| %>
          <li class="availability__item">
            <span class="availability__dates">
              Loué du <%= l(loan.start_date, format: :compact) %> au <%= l(loan.end_date, format: :compact) %>
            </span>
            <span class="availability__club"><%= loan.club.name %></span>
          </li>
        <% end %>
      </ul>
      <p class="availability__hint">Choisissez des dates en dehors de ces périodes.</p>
    <% else %>
      <p class="availability__free">Disponible à toutes les dates à venir.</p>
    <% end %>
  </section>
</div>
