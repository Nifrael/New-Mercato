<%# locals: (player:) -%>
<%# Carte du catalogue : toute la carte est un lien vers la fiche. Le prix par jour,
    l'information qui décide une location, est mis en avant en vert. %>
<%= link_to player_path(player), class: "card card--interactive player-card" do %>
  <div class="player-card__top">
    <%= player_avatar(player, size: :lg) %>
    <%= status_badge(player) %>
  </div>

  <div class="player-card__identity">
    <h2 class="player-card__name"><%= player.name %></h2>
    <p class="player-card__meta"><%= player.club.name %> · <%= player.age %> ans</p>
  </div>

  <span class="player-card__position"><%= t("activerecord.enums.player.position.#{player.position}") %></span>

  <dl class="player-card__figures">
    <div class="player-card__figure">
      <dt class="player-card__label">Valeur</dt>
      <dd class="player-card__value"><%= compact_currency(player.market_value) %></dd>
    </div>
    <div class="player-card__figure player-card__figure--price">
      <dt class="player-card__label">Par jour</dt>
      <dd class="player-card__value player-card__value--price"><%= number_to_currency(player.price_per_day, precision: 0) %></dd>
    </div>
  </dl>
<% end %>
