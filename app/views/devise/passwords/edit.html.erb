<% content_for(:title, "Nouveau mot de passe — New Mercato") %>

<div class="container auth">
  <div class="card auth__card">
    <header class="auth__header">
      <h1 class="auth__title">Nouveau mot de passe</h1>
      <% if @minimum_password_length %>
        <p class="auth__lead"><%= @minimum_password_length %> caractères minimum.</p>
      <% end %>
    </header>

    <%= form_with model: resource, scope: resource_name, url: password_path(resource_name), method: :put, class: "auth__form" do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div class="field">
        <%= f.label :password, "Nouveau mot de passe", class: "field__label" %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password", required: true, class: "field__input" %>
      </div>

      <div class="field">
        <%= f.label :password_confirmation, "Confirmez le mot de passe", class: "field__label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true, class: "field__input" %>
      </div>

      <%= f.submit "Enregistrer le mot de passe", class: "btn btn--primary btn--block" %>
    <% end %>
  </div>
</div>
