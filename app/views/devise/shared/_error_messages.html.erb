<%# locals: (resource:) -%>
<%# Erreurs de formulaire Devise (mot de passe oublié, nouveau mot de passe).
    role="alert" : annoncé immédiatement par les lecteurs d'écran. %>
<% if resource.errors.any? %>
  <div class="form-errors" role="alert">
    <p class="form-errors__title">
      <%= t("errors.messages.not_saved", count: resource.errors.count, resource: resource.class.model_name.human.downcase) %>
    </p>
    <ul class="form-errors__list">
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
