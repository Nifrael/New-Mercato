<% content_for(:title, "Demandes — New Mercato") %>

<div class="container page">
  <header class="page-header">
    <div class="page-header__text">
      <p class="page-header__eyebrow"><%= current_user.club.name %></p>
      <h1>Demandes de location</h1>
      <p class="page-header__lead">
        <%= @direction == :received ? "Les clubs qui veulent louer vos joueurs." : "Les joueurs que vous avez demandés à d'autres clubs." %>
      </p>
    </div>

    <%# Onglets = de vrais liens : chaque sens a son URL (partageable, bouton Retour qui fonctionne). %>
    <nav class="segmented" aria-label="Sens des demandes">
      <%= link_to "Reçues", dashboard_bookings_path,
                  class: "segmented__item", aria: { current: ("page" if @direction == :received) } %>
      <%= link_to "Envoyées", dashboard_bookings_path(direction: "sent"),
                  class: "segmented__item", aria: { current: ("page" if @direction == :sent) } %>
    </nav>
  </header>

  <div class="pipeline">
    <% @columns.each do |status, bookings| %>
      <section id="column-<%= status %>" class="pipeline__column" aria-labelledby="column-<%= status %>-title">
        <header class="pipeline__header">
          <span class="<%= class_names("pipeline__dot", "pipeline__dot--#{status_variant(:booking, status)}") %>" aria-hidden="true"></span>
          <h2 id="column-<%= status %>-title" class="pipeline__title"><%= t(".columns.#{status}") %></h2>
          <span class="pipeline__count"><%= bookings.size %></span>
        </header>

        <% if bookings.any? %>
          <%= render partial: "bookings/booking_card", collection: bookings, as: :booking,
                     locals: { direction: @direction, actions: @direction == :received && status == "pending" } %>
        <% else %>
          <p class="pipeline__empty">Aucune demande</p>
        <% end %>
      </section>
    <% end %>
  </div>
</div>
