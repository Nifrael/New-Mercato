<% content_for(:title, "Mon effectif — New Mercato") %>

<div class="container page">
  <%= render "dashboard/players/header", club: @club, counts: @tab_counts,
             title: "Mon effectif", lead: "Les joueurs disponibles aujourd'hui : les vôtres, plus ceux que vous empruntez." %>

  <% if @players.any? %>
    <div class="catalog__grid">
      <%= render partial: "players/player_card", collection: @players, as: :player %>
    </div>
  <% else %>
    <div class="empty-state">
      <p class="empty-state__title">Aucun joueur dans l'effectif</p>
      <p>Trouvez un joueur à louer pour renforcer votre équipe.</p>
    </div>
  <% end %>
</div>
