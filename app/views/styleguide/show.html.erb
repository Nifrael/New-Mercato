<% content_for(:title, "Styleguide — New Mercato") %>

<div class="container styleguide">
  <header class="styleguide__intro">
    <h1>Styleguide</h1>
    <p>Tous les composants du design system. Vérifier à 375px de large avant le desktop (mobile first).</p>
  </header>

  <section class="styleguide__section">
    <h2 class="styleguide__heading">Couleurs</h2>
    <div class="grid-auto styleguide__swatches">
      <% %w[bg-primary bg-surface bg-surface-hover border text text-secondary accent warning danger].each do |token| %>
        <div class="styleguide__swatch">
          <span class="styleguide__swatch-color styleguide__swatch-color--<%= token %>"></span>
          <code>--color-<%= token %></code>
        </div>
      <% end %>
    </div>
  </section>

  <section class="styleguide__section">
    <h2 class="styleguide__heading">Typographie</h2>
    <div class="stack">
      <h1>h1 — Caoimhín Kelleher</h1>
      <h2>h2 — Demandes reçues</h2>
      <h3>h3 — Répartition salariale</h3>
      <h4>h4 — Clause de rappel</h4>
      <h5>h5 — Titre de carte</h5>
      <p>p — Le club propriétaire accepte ou refuse la demande de location sur la période choisie.</p>
      <span>Texte de base (--base-size) — libellés, texte secondaire</span>
      <small>small (--little-text) — mentions</small>
    </div>
  </section>

  <section class="styleguide__section">
    <h2 class="styleguide__heading">Boutons</h2>
    <div class="cluster">
      <button type="button" class="btn btn--primary">Envoyer la demande</button>
      <button type="button" class="btn btn--secondary">Voir la fiche</button>
      <button type="button" class="btn btn--danger">Refuser</button>
      <button type="button" class="btn btn--primary" disabled>Désactivé</button>
    </div>
    <button type="button" class="btn btn--primary btn--block">Pleine largeur (.btn--block)</button>
  </section>

  <section class="styleguide__section">
    <h2 class="styleguide__heading">Badges de statut</h2>
    <div class="cluster">
      <% (@booking_statuses + @player_statuses).each do |record| %>
        <%= status_badge(record) %>
      <% end %>
    </div>
  </section>

  <section class="styleguide__section">
    <h2 class="styleguide__heading">Statistiques</h2>
    <div class="grid-auto styleguide__stats">
      <%= render "shared/stat", label: "Valeur marchande", value: number_to_currency(18_000_000, precision: 0) %>
      <%= render "shared/stat", label: "Prix / jour", value: number_to_currency(1_000, precision: 0) %>
      <%= render "shared/stat", label: "Âge", value: "25 ans" %>
      <%= render "shared/stat", label: "Marge", value: "+14,2 %", accent: true %>
    </div>
  </section>

  <section class="styleguide__section">
    <h2 class="styleguide__heading">Cartes</h2>
    <div class="grid-auto">
      <article class="card">
        <header class="card__header">
          <h3 class="card__title">Demande de location</h3>
          <%= status_badge(@booking_statuses.find(&:pending?)) %>
        </header>
        <div class="grid-auto styleguide__stats">
          <%= render "shared/stat", label: "Du", value: l(Date.current, format: :short) %>
          <%= render "shared/stat", label: "Au", value: l(Date.current + 14, format: :short) %>
          <%= render "shared/stat", label: "Total", value: number_to_currency(14_000, precision: 0), accent: true %>
        </div>
        <div class="cluster">
          <button type="button" class="btn btn--primary">Accepter</button>
          <button type="button" class="btn btn--danger">Refuser</button>
        </div>
      </article>

      <a href="#" class="card card--interactive">
        <header class="card__header">
          <h3 class="card__title">Carte cliquable</h3>
          <%= status_badge(@player_statuses.find(&:available?)) %>
        </header>
        <p>.card--interactive : toute la carte est un lien, la bordure s'éclaire au survol.</p>
      </a>
    </div>
  </section>
</div>
